%% --- UPDATED LOGISTIC REGRESSION: SPECT (MINORITY = 1) ---
% 1. Load SPECT files
spect_train = readtable('/Users/dakotawang/Downloads/spect+heart (1) 2/SPECT.train', 'FileType', 'text');
spect_test  = readtable('/Users/dakotawang/Downloads/spect+heart (1) 2/SPECT.test', 'FileType', 'text');

% FLIP LOGIC: If 0 was the minority, we make it the positive class (1)
Y_train_raw = table2array(spect_train(:, 1));
Y_test_raw  = table2array(spect_test(:, 1));
Y_train = (Y_train_raw == 0); % Now the original '0' is our '1'
Y_test  = (Y_test_raw == 0);

X_train = table2array(spect_train(:, 2:end)); 
X_test  = table2array(spect_test(:, 2:end));

% 2. Normalize & Train
manual_z = @(data) (data - mean(data)) ./ (std(data) + 1e-6);
X_train_s = manual_z(X_train); X_test_s = manual_z(X_test);
X_train_b = [ones(size(X_train_s,1),1) X_train_s];
w = zeros(size(X_train_b,2), 1);
lr = 0.1;

for i = 1:2000
    h = 1 ./ (1 + exp(-(X_train_b * w)));
    w = w - (lr/length(Y_train)) * (X_train_b' * (h - Y_train));
end

% 3. Test & Metrics
X_test_b = [ones(size(X_test_s,1),1) X_test_s];
pred = (1 ./ (1 + exp(-(X_test_b * w)))) >= 0.5;

calculate_final_metrics(Y_test, pred, 'Updated SPECT LogReg');

function calculate_final_metrics(y_true, y_pred, name)
    tp = sum(y_pred == 1 & y_true == 1); tn = sum(y_pred == 0 & y_true == 0);
    fp = sum(y_pred == 1 & y_true == 0); fn = sum(y_pred == 0 & y_true == 1);
    acc = (tp + tn) / length(y_true);
    f1_min = (2*tp) / (2*tp + fp + fn + 1e-6); 
    f1_maj = (2*tn) / (2*tn + fp + fn + 1e-6);
    fprintf('\n--- %s ---\n', name);
    fprintf('Accuracy: %.3f | F1-Sick (Min): %.3f | F1-Healthy (Maj): %.3f | Macro-F1: %.3f | FN: %d\n', ...
            acc, f1_min, f1_maj, (f1_min+f1_maj)/2, fn);
end
